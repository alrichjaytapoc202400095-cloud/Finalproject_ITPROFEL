# Base URL of the deployed Express API, WITHOUT a trailing slash and WITHOUT
# the /api/v1 suffix (the client adds it). Leave empty in development so the
# app uses the Vite proxy (/api -> http://localhost:5000).
#
# Local development:
#   VITE_API_BASE_URL=
#
# Production (example):
#   VITE_API_BASE_URL=https://spc-bookstore-api.vercel.app
VITE_API_BASE_URL=
