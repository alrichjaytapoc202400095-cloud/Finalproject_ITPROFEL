# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Database (MongoDB) ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=spcbookstore

# ---- Auth (keep secret out of Git; use a long random string) ----
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=2

# ---- CORS (comma separated list of allowed frontend origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---- Payment gateway (PayMongo TEST mode keys from dashboard) ----
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Maya Checkout sandbox (alternative: PAYMENT_PROVIDER=maya)
# Public key is used to create a checkout; secret key to read its status.
MAYA_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxx
MAYA_SECRET_KEY=sk_sandbox_xxxxxxxxxxxx
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
# Optional: pipe-separated PEM keys to override Maya's published webhook keys.
# MAYA_WEBHOOK_PUBLIC_KEYS=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----|...

# ---- AI provider (Google Gemini, backend only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000

# ---- Business rules ----
SHIPPING_FEE_CENTAVOS=5000
STUDENT_DISCOUNT_PERCENT=5
ORDER_EXPIRY_MINUTES=60
